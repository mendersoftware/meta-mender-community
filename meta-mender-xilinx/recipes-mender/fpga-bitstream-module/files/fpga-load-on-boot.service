# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Load persisted FPGA bitstream from /data/fpga
RequiresMountsFor=/data
After=local-fs.target
# finish the boot-time load before the Mender client can start a deployment
Before=mender-updated.service
ConditionPathExists=/data/fpga/current.bit.bin

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/fpga-load.sh

[Install]
WantedBy=multi-user.target

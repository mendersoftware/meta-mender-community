From 85b17b07729af29abdf2d24d03987494d40c3e13 Mon Sep 17 00:00:00 2001
From: Ed Watson <edmundwatson@gmail.com>
Date: Tue, 30 Sep 2025 10:09:11 +0200
Subject: [PATCH] Mender env setup sdcard

Signed-off-by: Ed Watson <edmundwatson@gmail.com>
---
 configs/stm32mp25_defconfig | 20 +++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/configs/stm32mp25_defconfig b/configs/stm32mp25_defconfig
index 0c8359a94ea..f7ce7af428b 100644
--- a/configs/stm32mp25_defconfig
+++ b/configs/stm32mp25_defconfig
@@ -3,13 +3,14 @@ CONFIG_USE_ARCH_MEMCPY=y
 CONFIG_ARCH_STM32MP=y
 CONFIG_SYS_MALLOC_F_LEN=0x500000
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x90000000
-CONFIG_ENV_OFFSET=0x900000
+CONFIG_ENV_SIZE=0x4000
+CONFIG_ENV_OFFSET=0x97C408
 CONFIG_ENV_SECT_SIZE=0x40000
 CONFIG_DEFAULT_DEVICE_TREE="stm32mp257f-ev1"
 CONFIG_STM32MP25X=y
 CONFIG_CMD_STM32KEY=y
 CONFIG_MFD_STM32_TIMERS=y
-CONFIG_ENV_OFFSET_REDUND=0x940000
+CONFIG_ENV_OFFSET_REDUND=0x980400
 CONFIG_TARGET_ST_STM32MP25X=y
 CONFIG_CMD_STM32PROG=y
 CONFIG_SYS_LOAD_ADDR=0x84000000
@@ -64,17 +65,17 @@ CONFIG_CMD_MTDPARTS=y
 CONFIG_CMD_LOG=y
 CONFIG_CMD_UBI=y
 CONFIG_OF_LIVE=y
-CONFIG_ENV_IS_NOWHERE=y
-CONFIG_ENV_IS_IN_FLASH=y
+CONFIG_ENV_IS_NOWHERE=n
+CONFIG_ENV_IS_IN_FLASH=n
 CONFIG_ENV_IS_IN_MMC=y
-CONFIG_ENV_IS_IN_SPI_FLASH=y
-CONFIG_ENV_IS_IN_UBI=y
+CONFIG_ENV_IS_IN_SPI_FLASH=n
+CONFIG_ENV_IS_IN_UBI=n
 CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
 CONFIG_ENV_ADDR_REDUND=0x60940000
 CONFIG_ENV_UBI_PART="UBI"
 CONFIG_ENV_UBI_VOLUME="uboot_config"
 CONFIG_ENV_UBI_VOLUME_REDUND="uboot_config_r"
-CONFIG_SYS_MMC_ENV_DEV=-1
+CONFIG_SYS_MMC_ENV_DEV=0
 CONFIG_USE_SERVERIP=y
 CONFIG_SERVERIP="192.168.1.1"
 CONFIG_SYS_64BIT_LBA=y
@@ -193,5 +194,10 @@ CONFIG_LMB_MEMORY_REGIONS=2
 CONFIG_LMB_RESERVED_REGIONS=32
 CONFIG_FWU_MULTI_BANK_UPDATE=y
 CONFIG_FWU_MDATA_V2=y
+CONFIG_ENV_SIZE=0x4000
 # CONFIG_TOOLS_MKEFICAPSULE is not set
 # CONFIG_TOOLS_MKFWUMDATA is not set
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_SYS_MMC_ENV_PART=0
+CONFIG_BOOTCOUNT_ENV=y
+CONFIG_ENV_IS_IN_MMC=y
\ No newline at end of file

[Unit]
Description=Load fTPM TEE Kernel Module
After=tee-supplicant@opteedev0.service
Requires=tee-supplicant@opteedev0.service
Before=cryptsetup-pre.target systemd-cryptsetup@.service
DefaultDependencies=no

[Service]
Type=oneshot
# The DT node (compatible = "microsoft,ftpm") triggers a udev/coldplug auto-load of
# tpm_ftpm_tee early in boot, BEFORE tee-supplicant is ready. The probe calls
# tee_client_open_session() which fails (TEEC_ERROR_COMMUNICATION, err=ffff000c)
# because OP-TEE has no supplicant yet to serve the TA load request.
# modprobe returns 0 when the module is already loaded, so a plain modprobe in this
# service would silently succeed while /dev/tpmrm0 is never created.
#
# Fix: always rmmod first to force a fresh probe attempt now that tee-supplicant is up.
ExecStart=/bin/sh -c '\
    /usr/sbin/modprobe -r tpm_ftpm_tee 2>/dev/null || true; \
    i=0; while [ $i -lt 30 ]; do \
        /usr/sbin/modprobe tpm_ftpm_tee && break; \
        echo "[load-ftpm-tee] modprobe failed, retry $i/30"; sleep 1; i=$((i+1)); \
    done; \
    [ $i -ge 30 ] && { echo "[load-ftpm-tee] ERROR: modprobe failed after 30 retries"; exit 1; }; \
    i=0; while [ $i -lt 60 ]; do \
        [ -c /dev/tpmrm0 ] && exit 0; \
        echo "[load-ftpm-tee] waiting for /dev/tpmrm0 ($i/60)"; sleep 1; i=$((i+1)); \
    done; \
    echo "[load-ftpm-tee] ERROR: /dev/tpmrm0 not created after 60s"; exit 1'
RemainAfterExit=yes

[Install]
WantedBy=cryptsetup-pre.target

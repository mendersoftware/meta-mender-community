From fad6d8b83d8e76683483498f5e4d10d91bf836bb Mon Sep 17 00:00:00 2001
From: Yair Ben Avraham <yair.b@variscite.com>
Date: Wed, 23 Apr 2025 10:23:29 +0300
Subject: [PATCH] imx8mp_var_dart.h: uboot cmds modifications to use mender
 variables

Signed-off-by: Yair Ben Avraham <yair.b@variscite.com>
---
 include/configs/imx8mp_var_dart.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/include/configs/imx8mp_var_dart.h b/include/configs/imx8mp_var_dart.h
index 4f011007830..96c77607430 100644
--- a/include/configs/imx8mp_var_dart.h
+++ b/include/configs/imx8mp_var_dart.h
@@ -115,7 +115,7 @@
 		"bootaux ${m7_addr};\0" \
 	"optargs=setenv bootargs ${bootargs} ${kernelargs};\0" \
 	"mmcargs=setenv bootargs console=${console} " \
-		"root=/dev/mmcblk${mmcblk}p${mmcpart} rootwait rw ${cma_size} cma_name=linux,cma\0 " \
+		"root=${mender_boot_part_name} rootwait rw ${cma_size} cma_name=linux,cma\0 " \
 	"loadbootscript=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bootdir}/${bsp_script};\0" \
 	"bootscript=echo Running bootscript from mmc ...; " \
 		"source\0" \
@@ -182,6 +182,7 @@
 			"fi; " \
 		"fi;\0" \
 	"bsp_bootcmd=echo Running BSP bootcmd ...; " \
+		"run mender_setup; " \
 		"run ramsize_check; " \
 		"mmc dev ${mmcdev}; " \
 		"if mmc rescan; then " \
-- 
2.25.1

